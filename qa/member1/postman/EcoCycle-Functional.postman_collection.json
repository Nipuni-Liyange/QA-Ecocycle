    {
      "name": "D - Update pending pickup (check 4)",
      "description": "Update with the current __v as version; verify the changed field and version increment; stale version is rejected.",
      "item": [
        {
          "name": "D1 Update pending pickup with current version",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"laptops\",\n  \"itemName\": \"QA test laptop (edited)\",\n  \"quantity\": 2,\n  \"condition\": \"needs-repair\",\n  \"description\": \"Synthetic test data only\",\n  \"district\": \"Colombo\",\n  \"city\": \"Colombo\",\n  \"address\": \"12 QA Test Road\",\n  \"preferredDate\": \"{{futureDate}}\",\n  \"version\": {{pickupVersion}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/pickups/{{pickupId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pickups",
                "{{pickupId}}"
              ],
              "query": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const oldVersion = Number(pm.collectionVariables.get('pickupVersion'));",
                  "pm.test('D1 status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('D1 itemName changed, still pending, version incremented', () => {",
                  "  pm.expect(body.request.itemName).to.eql('QA test laptop (edited)');",
                  "  pm.expect(body.request.status).to.eql('pending');",
                  "  pm.expect(body.request.__v).to.eql(oldVersion + 1);",
                  "});",
                  "pm.collectionVariables.set('staleVersion', oldVersion);",
                  "pm.collectionVariables.set('pickupVersion', body.request.__v);"
                ]
              }
            }
          ]
        },
        {
          "name": "D2 Update with stale version is rejected",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
