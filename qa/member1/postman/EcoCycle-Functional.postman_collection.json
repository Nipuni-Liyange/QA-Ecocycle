    {
      "name": "F - Authorization and session (check 6, optional)",
      "description": "Missing CSRF, logout, role enforcement (collector cannot create; user cannot use collector-only accept).",
      "item": [
        {
          "name": "F1 Create pickup without CSRF header is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
